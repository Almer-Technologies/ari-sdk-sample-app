<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: without this a partner cannot resolve
         Ari's provider, and every AriTools.setAvailable call reports AriMissing. -->
    <queries>
        <provider android:authorities="com.ari_os.ari.tools" />
    </queries>
</manifest>
